[Unit]
Description=Antminer T9+ Universal CMSIS-DAP v2 USB/IP Debug Probe
After=t9-fpga.service network.target
Requires=t9-fpga.service
PartOf=t9-fpga.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/plink/current/t9_programmer/usbip_dap
ExecStart=/opt/plink/current/t9_programmer/usbip_dap/t9-cmsis-dap
RuntimeDirectory=plink
RuntimeDirectoryPreserve=yes
Restart=always
RestartSec=1
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
