[Unit]
Description=Antminer T9+ Programmer FPGA Bitstream Loader
After=local-fs.target
Before=t9-openocd.service t9-uart-bridge.service t9-io-daemon.service t9-cmsis-dap.service

[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=30
ExecStart=/usr/bin/python3 /opt/plink/current/scripts/t9_load_bit.py /opt/plink/current/release/t9_programmer_pcap.bin --allow-live-hardware
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
